{{ template "base" . }}

{{ define "content" }}
<div class="page-header">
  <h2>Configuración</h2>
</div>

<div class="panel">
  <div class="row-inline">
    <label>
      Nombre de la empresa
      <input id="companyName" type="text" value="Correspondencia" />
    </label>
    <label>
      Moneda
      <select id="defaultCurrency">
        <option value="COP">COP</option>
        <option value="USD">USD</option>
      </select>
    </label>
  </div>

  <div class="checkbox-row">
    <label><input id="showAvicolaDashboard" type="checkbox" checked /> Mostrar módulo avícola en dashboard</label>
    <label><input id="allowCustomFields" type="checkbox" checked /> Permitir campos personalizados</label>
  </div>

  <div class="form-actions">
    <button class="button primary" id="saveConfig">Guardar configuración</button>
  </div>
</div>

<script src="/static/js/configuracion.js"></script>
{{ end }}
